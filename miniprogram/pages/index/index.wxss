.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #07c160;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.qrcode-box {
  width: 440rpx;
  height: 440rpx;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid #f0f0f0;
  background: #fafafa;
}

.qrcode {
  width: 100%;
  height: 100%;
}

.tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 40rpx 0;
}

.wechat-id-box {
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.wechat-id-label {
  color: #666;
}

.wechat-id {
  color: #07c160;
  font-weight: 600;
}

.copy-btn {
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.save-btn {
  background: #f0f0f0;
  color: #666;
  border-radius: 44rpx;
  font-size: 28rpx;
}
